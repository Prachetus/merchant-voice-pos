# Flask backend
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/merchant_voice_pos
MONGODB_DB=merchant_voice_pos

# Optional free LLM provider with OpenAI-compatible chat completions
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# Next.js frontend
NODE_ENV=production
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
